{
    "initializationAction": [
        "q.npc.is_doing_activity('cobblemon:battling') ? q.dialogue.set_page('in_battle');",
        "!q.player.data.seabling_leader_aave_defetead ? q.dialogue.set_page('intro1');",
        "q.player.data.seabling_leader_aave_defetead && !q.player.data.seabling_leader_aave_badge_given ? q.dialogue.set_page('post_defeat_badge1');",
        "q.player.data.seabling_leader_aave_defetead && q.player.data.seabling_leader_aave_badge_given ? q.dialogue.set_page('rematch');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face(false);"
        }
    },
    "pages": [
        {
            "id": "intro1",
            "speaker": "npc",
            "lines": [
                "Welcome challanger to my humble abode. Please don't mind my friends, they have a habbit of appering and disappering."
            ],
            "input": "q.dialogue.next_page();"
        },
        {
            "id": "intro2",
            "speaker": "npc",
            "lines": [
                "My ghost Pokémon are ready to haunt your gym challange. Are you sure your ready for the consequences of this battle?"
            ],
            "input": "q.dialogue.next_page();"
        },
        {
            "id": "battle_prompt",
            "speaker": "npc",
            "lines": [
                "Ready to be haunted?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": "q.dialogue.set_page('battle_start');"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start",
            "speaker": "npc",
            "lines": [
                "Well I warned you, please don't blame the spirts for your failure."
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player, 'double');"
            ]
        },
        {
            "id": "post_defeat_badge1",
            "speaker": "npc",
            "lines": [
                "It's rare that my friends cheer for anothers victory over me. Truely, this is wonderful to see."
            ],
            "input": "q.dialogue.next_page();"
        },
        {
            "id": "post_defeat_badge2",
            "speaker": "npc",
            "lines": [
                "You have earned the Fog Badge. Next time you come by, please bring some of your ghost friends, my friends seem to like you."
            ],
            "input": [
                "q.run_script('cobblemon:aave_give_badge');",  
                "q.dialogue.close();"             
            ]
        },
        {
            "id": "rematch",
            "speaker": "npc",
            "lines": [
                "Welcome back, do your friends want to play?"
            ],
            "input": "q.dialogue.set_page('battle_prompt');"
        },
        {
            "id": "in_battle",
            "speaker": "npc",
            "lines": [
                "Please give others the chance to battle me."
            ],
            "input": "q.dialogue.close();"
        }
    ]
}