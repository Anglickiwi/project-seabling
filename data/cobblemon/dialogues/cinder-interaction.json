{
    "initializationAction": [
        "q.npc.is_doing_activity('cobblemon:battling') ? q.dialogue.set_page('in_battle');",
        "!q.player.data.seabling_leader_cinder_defetead ? q.dialogue.set_page('intro1');",
        "q.player.data.seabling_leader_cinder_defetead && !q.player.data.seabling_leader_cinder_badge_given ? q.dialogue.set_page('post_defeat_badge1');",
        "q.player.data.seabling_leader_cinder_defetead && q.player.data.seabling_leader_cinder_badge_given ? q.dialogue.set_page('rematch');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face(false);"
        }
    },
    "pages": [
        {
            "id": "intro1",
            "speaker": "npc",
            "lines": [
                "Challenger! I'm cinder, the Fire Gym Leader. I hope your ready to get burned!"
            ],
            "input": "q.dialogue.next_page();"
        },
        {
            "id": "intro2",
            "speaker": "npc",
            "lines": [
                "My fire Pokémon are ready to burn your team to ashes! You sure you want to contuine?"
            ],
            "input": "q.dialogue.next_page();"
        },
        {
            "id": "battle_prompt",
            "speaker": "npc",
            "lines": [
                "Ready to get burned?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": "q.dialogue.set_page('battle_start');"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start",
            "speaker": "npc",
            "lines": [
                "Hope you brought some burn heals then!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player, 'double');"
            ]
        },
        {
            "id": "post_defeat_badge1",
            "speaker": "npc",
            "lines": [
                "I hve been burnt by my own flames!"
            ],
            "input": "q.dialogue.next_page();"
        },
        {
            "id": "post_defeat_badge2",
            "speaker": "npc",
            "lines": [
                "You have earned the Heat Badge! Come back any time to rematch me!"
            ],
            "input": [
                "q.run_script('cobblemon:cinder_give_badge');",  
                "q.dialogue.close();"             
            ]
        },
        {
            "id": "rematch",
            "speaker": "npc",
            "lines": [
                "Hah! Well done, returning here! Since you came all this way, we should have a battle! Hah!"
            ],
            "input": "q.dialogue.set_page('battle_prompt');"
        },
        {
            "id": "in_battle",
            "speaker": "npc",
            "lines": [
                "Please give others the chance to battle me."
            ],
            "input": "q.dialogue.close();"
        }
    ]
}