    defense_iv=31 
    special_attack_iv=31 
    special_defense_iv=31 
    speed_iv=31 

    hp_ev=248  
    attack_ev=0 
    defense_ev=0 
    special_attack_ev=252   
    special_defense_ev=8 
    speed_ev=0 

    level=' + t.pokemon_level
);
